<?xml version="1.0" encoding="UTF-8"?>
<text date="25-04-2022"
    section="Gesellschaftsvertreter beraten über Perspektiven von ukrainischen Flüchtlingen in Deutschland"
        ><inst id="" frame="Integration">Im Kanzleramt haben <element type="fe" frame="Integration"
            slot="Akteur" id="" relation="" level="0" parent=""><element type="fee"
                frame="Institutionen" level="1" parent="Integration" slot="" relation="">Bund ,
                Länder , Kommunen und Verbände</element></element> beraten , wie <element type="fe"
            frame="Integration" slot="Teil" id="" relation="" level="0" parent=""><element
                type="fee" frame="Personen_nach_Herkunft" level="1" parent="Integration" slot=""
                relation="">ukrainische Flüchtlinge</element></element> in <element type="fe"
            frame="Integration" slot="Ganzes" id="" relation="" level="0" parent=""><element
                type="fee" frame="Politische_Örtlichkeit|Ausland_oder_Inland" level="1"
                parent="Integration" slot="" relation="">Deutschland</element></element>
        <element type="fee" frame="Integration" level="0" parent="" slot="" relation=""
            >integriert</element> werden können . <element type="fe" frame="Integration"
            slot="Grund" id="" relation="" level="0" parent="">Eine schnelle <element type="fee"
                frame="Eigenbewegung" level="1" parent="Integration" slot="" relation=""
                >Rückkehr</element> in die Heimat sei <element type="fee" frame="Gewissheit"
                level="1" parent="Integration" slot="" relation="">ungewiss</element></element> .
        Deshalb müssten <element type="fe" frame="Integration" slot="Maßnahmen" id="" relation=""
            level="0" parent=""><element type="fee" frame="Unterstützen" level="1"
                parent="Integration" slot="" relation="">Perspektiven geschaffen werden</element> -
            auch mit Blick auf <element type="fee" frame="Bildung_Lehre" level="1" parent="Integration"
                slot="" relation="">Kinderbetreuung und Schulbildung</element></element> .</inst>
(gelöschter Text)
        <inst id="" frame="Integration">Damit es hier und nicht in Städten voller wird , müssen
            <element type="fe" frame="Integration" slot="Teil" id="" relation="" level="0" parent=""
                ><element type="fee" frame="Geflüchtete" level="1" parent="Integration" slot=""
                relation="">Geflüchtete</element></element> besser informiert werden , betonen
        Kommunalverbände . Es muss klargemacht werden , dass der ländliche Raum hohe <element
            type="fee" frame="Integration" level="0" parent="" slot="" relation=""
            >Integrationskraft</element> hat . Und ein tolles <element type="fe" frame="Integration"
            slot="Maßnahmen" id="" relation="" level="0" parent=""><element type="fee"
                frame="Versorgung" level="1" parent="Integration" slot="" relation="">Angebot
                an</element>
            <element type="fee" frame="Bildung_Lehre" level="1" parent="Integration" slot="" relation=""
                >Schulen , Kindergärten</element> und an Nachbarschaft</element> . <element
            type="fe" frame="Integration" slot="Folgen" relation="" level="0" parent="">Das kann
                <element type="fee" frame="Unterstützen" level="1" parent="Integration" slot=""
                relation="">helfen</element> , dass die <element type="fee" frame="Menschen"
                level="1" parent="Integration" slot="" relation="">Menschen</element> sich <element
                type="fee" frame="Emotionen_durch_Stimulus" level="1" parent="Integration" slot=""
                relation="">wohlfühlen</element> .</element></inst>
(gelöschter Text)
				</text>
